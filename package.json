{
  "name": "shadowspec",
  "version": "0.1.0",
  "description": "Behavioral regression testing from production traffic",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shadowspec": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capture-schema.sql": "./sql/capture-schema.sql",
    "./replay-target-schema.sql": "./sql/replay-target-schema.sql",
    "./authorize-replay-target.sql.example": "./sql/authorize-replay-target.sql.example"
  },
  "files": [
    "dist",
    "sql/capture-schema.sql",
    "sql/replay-target-schema.sql",
    "sql/authorize-replay-target.sql.example"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "export": "tsx src/export-scenarios.ts",
    "replay": "tsx src/run-replay.ts",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "api",
    "testing",
    "regression",
    "behavioral-testing",
    "github",
    "ai"
  ],
  "author": "Nikola Gasparevic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolagasparevic/shadowspec-demo-api.git"
  },
  "bugs": {
    "url": "https://github.com/nikolagasparevic/shadowspec-demo-api/issues"
  },
  "homepage": "https://github.com/nikolagasparevic/shadowspec-demo-api#readme",
  "type": "commonjs",
  "dependencies": {
    "@fastify/postgres": "^6.1.0",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fastify": "^5.12.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}